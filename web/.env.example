# ====== Infarm CS (Next.js) — Konfigurasi ======
# Salin file ini menjadi ".env.local" lalu isi nilainya.
# .env.local TIDAK ikut ter-commit (lihat .gitignore).
# Di produksi, isi nilai yang sama di Vercel → Project Settings →
# Environment Variables (Step 15). Jangan pernah menaruh key di kode.

# API key Claude (Anthropic). Ambil di:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Claude — default mengikuti Tech Stack di claude.md.
CLAUDE_MODEL=claude-sonnet-4-6

# Maksimum token balasan (balasan CS singkat 2-5 kalimat → 600 cukup).
MAX_TOKENS=600

# ====== Supabase ======
# Isi keduanya untuk MENYALAKAN login + database. Selama masih
# kosong, console berjalan di mode demo (data contoh di memori)
# dan tidak ada layar login. Tidak ada kode yang perlu diubah.
#
# Ambil di: Supabase -> Project Settings -> API
# Jalankan supabase/schema.sql & schema-kb.sql lebih dulu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role MENEMBUS SELURUH aturan RLS. Dua aturan mutlak:
#   1. Tidak pernah diberi awalan NEXT_PUBLIC_ — awalan itu yang
#      membuat sebuah variabel ikut terkirim ke peramban.
#   2. Hanya dibaca satu berkas: lib/supabase/admin.ts (server-only),
#      untuk tabel marketplace_shops yang berisi token toko dan
#      memang tidak boleh dibaca akun mana pun lewat RLS.
# Semua akses lain tetap memakai anon key + sesi pengguna.
SUPABASE_SERVICE_ROLE_KEY=

# ====== Pengaman saldo (opsional) ======
# AI_TEST_LOCK=1 menolak SEMUA panggilan berbayar ke Claude sebelum
# dikirim. Jalur template tetap berjalan, jadi console masih bisa
# didemokan — yang mati hanya yang memotong saldo.
#
# Nyalakan saat menyerahkan proyek ke orang lain, saat menjalankan
# agen coding, atau kapan pun tidak ingin ada panggilan tak terduga.
# Hapus barisnya (atau isi 0) lalu jalankan ulang server untuk membuka.
# AI_TEST_LOCK=1

# ====== Voyage (Gerbang 2 — Pengenal Maksud) ======
# Mengubah kalimat jadi deretan angka supaya "nem oilnya dipakenya
# gmn kak" bisa ketemu template yang sama dengan "cara pakai neem
# oil" — walau tidak ada satu kata pun yang sama persis.
#
# Ambil di: https://dashboard.voyageai.com/ -> API Keys
# Tempel setelah tanda = tanpa spasi dan tanpa tanda kutip.
#
# INI KUNCI SISI SERVER. Namanya sengaja TIDAK diawali
# NEXT_PUBLIC_ supaya tidak ikut terkirim ke peramban pengunjung.
VOYAGE_API_KEY=

# Nama model. Kosongkan untuk memakai voyage-4-lite.
# WAJIB dicocokkan dengan nama persis di dasbor Voyage — nama yang
# salah membuat panggilan gagal dengan HTTP 400.
#
# Periksa juga dukungan bahasa Indonesianya. Pelanggan menulis
# "gmn", "brp", "kk" — kalau modelnya berpusat pada bahasa Inggris,
# justru kalimat itulah yang paling dulu meleset, padahal itu alasan
# Gerbang 2 dibangun.
# VOYAGE_MODEL=voyage-4-lite

# Tarif untuk laporan perkiraan biaya. Cocokkan dengan halaman harga
# Voyage — angka yang usang membuat laporan biaya diam-diam bohong.
# VOYAGE_USD_PER_MTOK=0.02
# USD_TO_IDR=16500

# Mengunci Voyage SENDIRIAN, tanpa ikut mengunci Claude. Berguna
# saat kuota gratis 200 juta token menipis. AI_TEST_LOCK=1 di atas
# tetap mengunci keduanya sekaligus.
# VOYAGE_LOCK=1

# ====== Shopee Open Platform ======
# Partner ID dan partner key dari konsol Shopee. Keduanya hanya
# dibaca lib/shopee/klien.ts (server-only); nama tanpa NEXT_PUBLIC_
# adalah pagar yang sesungguhnya, bukan komentar ini.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Kosong = sandbox cluster Singapura (lihat lib/shopee/tandaTangan.ts).
# Produksi: https://partner.shopeemobile.com — disetel eksplisit,
# tidak pernah ditebak dari NODE_ENV.
SHOPEE_HOST=

# URL balik setelah pemilik toko menyetujui otorisasi. Harus persis
# sama dengan yang terdaftar di konsol Shopee, termasuk https dan
# tanpa garis miring di ujung.
SHOPEE_REDIRECT_URL=

# Kunci tambahan untuk memeriksa tanda tangan /api/shopee/push.
# LIVE = partner key aplikasi live. TEST_PUSH = "Test Push Partner Key"
# di Console → Push Mechanism → Get Test Push (dipakai tombol Push
# Test Data). Kosong = diabaikan.
SHOPEE_LIVE_PARTNER_KEY=
SHOPEE_TEST_PUSH_KEY=

# Jawaban mentah get_order_detail yang disimpan di tabel orders_raw
# (hanya untuk debug; tiap baris ±2 KB). Pilihan:
#   galat  (bawaan) hanya pesanan yang pemetaannya meragukan: status
#          'lainnya', status asli kosong, barang kosong, atau waktu
#          dibuat tidak terbaca
#   off    tidak pernah menyimpan
#   semua  setiap pesanan — JANGAN untuk toko besar, database Free
#          500 MB penuh dalam beberapa minggu
# Kosong atau nilai lain = galat.
SHOPEE_SIMPAN_RAW=galat

# Hanya untuk halaman uji /shopee selama Fase 1 integrasi. Sejak
# Fase 3 token dibaca dari tabel marketplace_shops dan dua baris ini
# tidak dibaca lagi — boleh dihapus saat itu.
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=

# ====== Sinkronisasi terjadwal ======
# Dicocokkan dengan header "Authorization: Bearer <nilai>" oleh
# /api/sync/*. Pakai nilai acak panjang; ini satu-satunya yang
# menghalangi orang luar memicu sinkronisasi.
CRON_SECRET=
